+"""Bounded gate for background model calls made by self-learning."""
+
+import asyncio
+import time
+import weakref
+from contextlib import asynccontextmanager
+
+
+class BackgroundRequestGate:
+    def __init__(
+        self,
+        capacity: int = 32,
+        wait_timeout: float = 180.0,
+        foreground_grace: float = 10.0,
+        rate_limit_cooldown: float = 30.0,
+    ) -> None:
+        self.capacity = capacity
+        self.wait_timeout = wait_timeout
+        self.foreground_grace = foreground_grace
+        self.rate_limit_cooldown = rate_limit_cooldown
+        self.pending = 0
+        self._lock = asyncio.Lock()
+        self._quiet_until = 0.0
+
+    def note_foreground_request(self) -> None:
+        self._quiet_until = max(
+            self._quiet_until,
+            time.monotonic() + self.foreground_grace,
+        )
+
+    @asynccontextmanager
+    async def slot(self):
+        if self.pending >= self.capacity:
+            raise RuntimeError("self-learning background model queue is full")
+
+        self.pending += 1
+        acquired = False
+        deadline = time.monotonic() + self.wait_timeout
+        try:
+            await asyncio.wait_for(
+                self._lock.acquire(), timeout=self.wait_timeout
+            )
+            acquired = True
+            while self._quiet_until > time.monotonic():
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError(
+                        "self-learning background model queue deadline exceeded"
+                    )
+                await asyncio.sleep(
+                    min(self._quiet_until - time.monotonic(), remaining)
+                )
+            yield
+        except Exception as exc:
+            message = str(exc).lower()
+            if (
+                getattr(exc, "status_code", None) == 429
+                or "gateway_concurrency_limit" in message
+                or "too many requests" in message
+            ):
+                self._quiet_until = max(
+                    self._quiet_until,
+                    time.monotonic() + self.rate_limit_cooldown,
+                )
+            raise
+        finally:
+            if acquired:
+                self._lock.release()
+            self.pending -= 1
+
+
+_GATES = weakref.WeakKeyDictionary()
+
+
+def get_background_request_gate() -> BackgroundRequestGate:
+    loop = asyncio.get_running_loop()
+    gate = _GATES.get(loop)
+    if gate is None:
+        gate = BackgroundRequestGate()
+        _GATES[loop] = gate
+    return gate
+
+
+def note_foreground_request() -> None:
+    get_background_request_gate().note_foreground_request()
+
+
+async def queued_text_chat(provider, **kwargs):
+    async with get_background_request_gate().slot():
+        return await provider.text_chat(**kwargs)
