diff --git a/tests/unit/test_background_request_gate.py b/tests/unit/test_background_request_gate.py
new file mode 100644
index 0000000..9737d12
--- /dev/null
+++ b/tests/unit/test_background_request_gate.py
@@ -0,0 +1,61 @@
+import asyncio
+import time
+
+import pytest
+
+from self_learning_EterU.utils.background_request_gate import BackgroundRequestGate
+
+
+@pytest.mark.unit
+@pytest.mark.asyncio
+async def test_gate_serializes_background_calls():
+    gate = BackgroundRequestGate(foreground_grace=0)
+    active = 0
+    peak = 0
+
+    async def worker():
+        nonlocal active, peak
+        async with gate.slot():
+            active += 1
+            peak = max(peak, active)
+            await asyncio.sleep(0.005)
+            active -= 1
+
+    await asyncio.gather(*(worker() for _ in range(8)))
+
+    assert peak == 1
+    assert gate.pending == 0
+
+
+@pytest.mark.unit
+@pytest.mark.asyncio
+async def test_foreground_and_rate_limit_defer_following_background_calls():
+    gate = BackgroundRequestGate(
+        foreground_grace=0.02,
+        rate_limit_cooldown=0.02,
+    )
+    gate.note_foreground_request()
+    started = time.monotonic()
+    async with gate.slot():
+        pass
+    assert time.monotonic() - started >= 0.015
+
+    with pytest.raises(RuntimeError, match="gateway_concurrency_limit"):
+        async with gate.slot():
+            raise RuntimeError("gateway_concurrency_limit")
+
+    started = time.monotonic()
+    async with gate.slot():
+        pass
+    assert time.monotonic() - started >= 0.015
+
+
+@pytest.mark.unit
+@pytest.mark.asyncio
+async def test_queue_capacity_rejects_excess_work_without_leaking_count():
+    gate = BackgroundRequestGate(capacity=1, foreground_grace=0)
+    async with gate.slot():
+        with pytest.raises(RuntimeError, match="queue is full"):
+            async with gate.slot():
+                pass
+    assert gate.pending == 0
