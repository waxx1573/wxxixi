FROM soulter/astrbot@sha256:cf271483d2f03d2220b2c1ec5574747f4ebbdba27396421ef2e785474255856e

COPY runtime-python-requirements.txt /tmp/astrbot-runtime-requirements.txt
RUN uv pip install --system -r /tmp/astrbot-runtime-requirements.txt \
    && python -m playwright install --with-deps chromium chromium-headless-shell
